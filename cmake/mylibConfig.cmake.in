# -----------------------------------------------------------------------------
# mylibConfig.cmake - CMake package for an installed mylib.
#
#   find_package(mylib CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE mylib::mylib)
#
# Provides:
#
#   mylib::mylib           the library (static or shared, see mylib_SHARED)
#
#   mylib_SHARED           TRUE if the installed library is a shared library
#   mylib_RUNTIME_DIR      directory holding the DLLs and their PDBs; copy its
#                          contents next to your executable (Windows, shared)
#   mylib_SOURCE_ROOT      this package's folder. The library's debug info
#                          names its sources /mylib/src/... (MSVC:
#                          \mylib\src\...); a Debug package ships them in src/
#                          here, so map /mylib to this folder in your debugger
#                          to step into mylib
#
# Dependencies are found again here, with the find modules the library's own
# build uses (Threads: CMake's own).
# -----------------------------------------------------------------------------

@PACKAGE_INIT@

set(mylib_SHARED @MYLIB_PACKAGE_SHARED@)
set(mylib_RUNTIME_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
set(mylib_SOURCE_ROOT "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)

find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/mylibTargets.cmake")

check_required_components(mylib)
