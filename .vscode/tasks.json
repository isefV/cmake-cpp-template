{
    // CMake tasks for any CMake project: "Terminal > Run Task..." (Ctrl+Shift+B
    // = CMake: build). Plain cmake command lines; the choices come from
    // .vscode/build.json (targets, build types, kits, linkages, each with its
    // default first), read by the Command Variable extension
    // (rioj7.command-variable, see extensions.json).
    //
    //   CMake: build    target > build type > kit > linkage: configure
    //                   build/<kit>-<build type>-<linkage>, build the target,
    //                   point build/current at that folder
    //   CMake: clean    build type > kit > linkage: delete that build folder
    //   CMake: install  build type > kit > linkage: build build.json's
    //                   install target, install to install/<kit>-<linkage>
    //
    // Windows: the tasks run in PowerShell, which first loads the Visual
    // Studio developer environment (cl, Ninja), so no Developer Command Prompt
    // is needed. A failing step stops the chain (the cmake function below;
    // Windows PowerShell has no "&&"). Linux: bash -e, which also stops at the
    // first failing step.
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-Command",
                    "$installer = Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'Microsoft Visual Studio\\Installer';",
                    "$vs = & (Join-Path $installer 'vswhere.exe') -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath;",
                    "$env:PATH += ';' + $installer;",
                    "Import-Module (Join-Path $vs 'Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll');",
                    "Enter-VsDevShell -VsInstallPath $vs -SkipAutomaticLocation -DevCmdArguments '-arch=x64 -host_arch=x64' | Out-Null;",
                    "function cmake { & (Get-Command cmake -CommandType Application)[0].Source @args; if ($LASTEXITCODE) { exit $LASTEXITCODE } };"
                ]
            }
        }
    },
    "linux": {
        "options": { "shell": { "executable": "bash", "args": [ "-e", "-c" ] } }
    },
    "osx": {
        "options": { "shell": { "executable": "bash", "args": [ "-e", "-c" ] } }
    },
    "tasks": [
        {
            "label": "CMake: build",
            "detail": "Configure and build a target (build.json: target, build type, kit, linkage)",
            "type": "shell",
            "windows": {
                "command": "echo '${input:target} | ${input:buildType} | ${input:kit} | ${input:linkage}'; cmake -S . -B build/${input:kit}-${input:buildType}-${input:linkage} -DCMAKE_BUILD_TYPE=${input:buildType} ${input:kitCMake} ${input:linkageCMake} ${input:targetCMake}; cmake --build build/${input:kit}-${input:buildType}-${input:linkage} --config ${input:buildType} ${input:targetBuild}; cmd /c 'rmdir build\\current 2>nul & mklink /J build\\current build\\${input:kit}-${input:buildType}-${input:linkage} >nul'"
            },
            "command": "echo '${input:target} | ${input:buildType} | ${input:kit} | ${input:linkage}'; cmake -S . -B build/${input:kit}-${input:buildType}-${input:linkage} -DCMAKE_BUILD_TYPE=${input:buildType} ${input:kitCMake} ${input:linkageCMake} ${input:targetCMake}; cmake --build build/${input:kit}-${input:buildType}-${input:linkage} --config ${input:buildType} ${input:targetBuild}; ln -sfn ${input:kit}-${input:buildType}-${input:linkage} build/current",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [ "$msCompile", "$gcc" ]
        },
        {
            "label": "CMake: clean",
            "detail": "Delete a build folder (build.json: build type, kit, linkage)",
            "type": "shell",
            "command": "echo '${input:buildType} | ${input:kit} | ${input:linkage}'; cmake -E rm -rf build/${input:kit}-${input:buildType}-${input:linkage}",
            "problemMatcher": []
        },
        {
            "label": "CMake: install",
            "detail": "Build the library and install it (build.json: build type, kit, linkage; install target)",
            "type": "shell",
            "command": "echo '${input:buildType} | ${input:kit} | ${input:linkage}'; cmake -S . -B build/${input:kit}-${input:buildType}-${input:linkage} -DCMAKE_BUILD_TYPE=${input:buildType} ${input:kitCMake} ${input:linkageCMake}; cmake --build build/${input:kit}-${input:buildType}-${input:linkage} --config ${input:buildType} --target ${input:installTarget}; cmake --install build/${input:kit}-${input:buildType}-${input:linkage} --config ${input:buildType} --prefix install/${input:kit}-${input:linkage}",
            "problemMatcher": [ "$msCompile", "$gcc" ]
        }
    ],
    "inputs": [
        // The four questions: a pick list from a build.json section, its
        // default first. A pick also remembers the item's cmake arguments.
        {
            "id": "target",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Target",
                "key": "target",
                "fileName": "${workspaceFolder}/.vscode/build.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.targets.items[__itemIdx__].name",
                    "description": "content.targets.items[__itemIdx__].description || ''",
                    "value": {
                        "target": "content.targets.items[__itemIdx__].name",
                        "targetCMake": "content.targets.items[__itemIdx__].cmake || ''",
                        "targetBuild": "content.targets.items[__itemIdx__].name === 'all' ? '' : '--target ' + content.targets.items[__itemIdx__].name"
                    }
                },
                "addLabelToTop": "${fileContent:default}",
                "fileContent": {
                    "default": { "fileName": "${workspaceFolder}/.vscode/build.json", "json": "content.targets.default" }
                }
            }
        },
        {
            "id": "buildType",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Build type",
                "key": "buildType",
                "fileName": "${workspaceFolder}/.vscode/build.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.buildTypes.items[__itemIdx__].name",
                    "description": "content.buildTypes.items[__itemIdx__].description || ''",
                    "value": "content.buildTypes.items[__itemIdx__].name"
                },
                "addLabelToTop": "${fileContent:default}",
                "fileContent": {
                    "default": { "fileName": "${workspaceFolder}/.vscode/build.json", "json": "content.buildTypes.default" }
                }
            }
        },
        {
            "id": "kit",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Kit (compiler)",
                "key": "kit",
                "fileName": "${workspaceFolder}/.vscode/build.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.kits.items[__itemIdx__].name",
                    "description": "content.kits.items[__itemIdx__].description || ''",
                    "value": {
                        "kit": "content.kits.items[__itemIdx__].name",
                        "kitCMake": "content.kits.items[__itemIdx__].cmake || ''"
                    }
                },
                "addLabelToTop": "${fileContent:default}",
                "fileContent": {
                    "default": { "fileName": "${workspaceFolder}/.vscode/build.json", "json": "content.kits.default" }
                }
            }
        },
        {
            "id": "linkage",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Linkage",
                "key": "linkage",
                "fileName": "${workspaceFolder}/.vscode/build.json",
                "fileFormat": "json",
                "jsonOption": {
                    "label": "content.linkages.items[__itemIdx__].name",
                    "description": "content.linkages.items[__itemIdx__].description || ''",
                    "value": {
                        "linkage": "content.linkages.items[__itemIdx__].name",
                        "linkageCMake": "content.linkages.items[__itemIdx__].cmake || ''"
                    }
                },
                "addLabelToTop": "${fileContent:default}",
                "fileContent": {
                    "default": { "fileName": "${workspaceFolder}/.vscode/build.json", "json": "content.linkages.default" }
                }
            }
        },

        // The cmake arguments of the picked items.
        { "id": "targetCMake", "type": "command", "command": "extension.commandvariable.remember", "args": { "key": "targetCMake" } },
        { "id": "targetBuild", "type": "command", "command": "extension.commandvariable.remember", "args": { "key": "targetBuild" } },
        { "id": "kitCMake", "type": "command", "command": "extension.commandvariable.remember", "args": { "key": "kitCMake" } },
        { "id": "linkageCMake", "type": "command", "command": "extension.commandvariable.remember", "args": { "key": "linkageCMake" } },

        // build.json's install target.
        {
            "id": "installTarget",
            "type": "command",
            "command": "extension.commandvariable.file.content",
            "args": { "fileName": "${workspaceFolder}/.vscode/build.json", "json": "content.install.target" }
        }
    ]
}
