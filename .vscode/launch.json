{
    // The programs of the build folder built last: build/current, which
    // "CMake: build" points at build/<kit>-<build type>-<linkage>. Build the
    // program's target first (an app with its MYLIB_BUILD_APP_* option, which
    // build.json's target list sets).
    //
    // The entries use the MSVC debugger (cppvsdbg); for GDB (gcc on Windows,
    // or Linux) use "type": "cppdbg", "MIMode": "gdb" (no ".exe" on Linux), map
    // "/mylib" instead of "\mylib".
    //
    // mylib's debug info names its sources \mylib\src\... (the same on every
    // PC); "sourceFileMap" points that root at the folder holding them: this
    // checkout, or an installed Debug package (it ships src/).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: mylib_app",
            "type": "cppvsdbg",
            "request": "launch",
            "sourceFileMap": { "\\mylib": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/current/bin/mylib_app.exe",
            "args": [],
            "cwd": "${workspaceFolder}/build/current/bin",
            "console": "integratedTerminal"
        },
        {
            "name": "Tests: mylib_tests",
            "type": "cppvsdbg",
            "request": "launch",
            "sourceFileMap": { "\\mylib": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/current/bin/mylib_tests.exe",
            "args": [],
            "cwd": "${workspaceFolder}/build/current/bin",
            "console": "integratedTerminal"
        },
        {
            "name": "App: mylib_boost",
            "type": "cppvsdbg",
            "request": "launch",
            "sourceFileMap": { "\\mylib": "${workspaceFolder}" },
            "program": "${workspaceFolder}/build/current/bin/mylib_boost.exe",
            "args": [ "--from", "1", "--to", "10" ],
            "cwd": "${workspaceFolder}/build/current/bin",
            "console": "integratedTerminal"
        },
        {
            "name": "App: mylib_nlohmann_json",
            "type": "cppvsdbg",
            "request": "launch",
            "sourceFileMap": { "\\mylib": "${workspaceFolder}" },
